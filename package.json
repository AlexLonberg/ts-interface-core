{
  "name": "ts-interface-core",
  "version": "0.4.0",
  "description": "Mark and detect interface conformance with instanceof.",
  "author": "Alexander Lonberg <alexlonberg@gmail.com>",
  "homepage": "https://github.com/AlexLonberg/ts-interface-core",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexLonberg/ts-interface-core.git"
  },
  "license": "MIT",
  "keywords": [
    "typescript",
    "interface",
    "implements",
    "instanceof"
  ],
  "scripts": {
    "lint": "eslint --config ./eslint.config.js",
    "test": "vitest run --coverage --config vitest.config.ts",
    "bench": "vitest bench --config vitest.config.ts",
    "predist": "npm run lint && vitest run --browser.enabled=false --coverage.enabled=false --config vitest.config.ts && node ./scripts/dist.js",
    "dist": "tsc --project tsconfig.dist.json"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "private": true,
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "main": "./src/index.ts"
}
