{
  // DOC VSCode glob patterns https://code.visualstudio.com/docs/editor/glob-patterns
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    ".temp/": true,
    "dist/": true,
    "**/*.json": true,
    "eslint.rules.js": true,
    "eslint.config.js": true,
    "vitest.config.ts": true,
    "LICENSE.md": true
  },
  "googleSearchContextMenu.items": {
    "MDNWeb": {
      "enabled": true
    },
    "NodeJS": {
      "enabled": true
    }
  },
  "eslint.runtime": "node",
  "eslint.useESLintClass": true,
  "eslint.useFlatConfig": true,
  "eslint.codeActionsOnSave.mode": "problems",
  // Отключаем действия для правил удаляющих код при форматировании. Если выше включен mode:"problems" - эта настройка игнорируется.
  // !rule - off
  // *     - on
  "eslint.codeActionsOnSave.rules": [
    "!no-unused-vars",
    "!@typescript-eslint/no-unused-vars",
    "*"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
    // Обе опции не могут сортировать импорт начиная с типов
    // "source.organizeImports": "explicit",
    // "source.sortImports": "explicit"
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  // Без этой настройки тесты, в режиме Debug, не запускаются на D:/*-диске
  "vitest.shellType": "terminal"
}
